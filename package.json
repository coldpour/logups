{
  "name": "logups",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@clerk/react": "^6.1.0",
    "@clerk/shared": "^4.3.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.4",
    "@mui/material": "^6.4.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "firebase": "^12.7.0",
    "netlify-plugin-firebase-cache": "^0.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "source-map-explorer": "^2.5.3"
  },
  "scripts": {
    "analyze": "source-map-explorer 'dist/assets/*.js'",
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:web && npm run test:rules",
    "test:web": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore 'jest ./test'",
    "deploy:functions": "firebase deploy --only functions",
    "emulate": "firebase emulators:start --only firestore"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "firebase-tools": "^15.1.0",
    "jest": "^30.2.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.7.4",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
